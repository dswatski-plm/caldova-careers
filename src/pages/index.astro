---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import RoleCard from '../components/RoleCard.astro';
import EmptyState from '../components/EmptyState.astro';
import { sortByNewest } from '../lib/jobs';
import type { Job } from '../types/job';

export const prerender = true;

const entries = await getCollection('jobs');
const jobs: Job[] = sortByNewest(
    entries.map((entry) => ({ slug: entry.id, ...entry.data })),
);
const departments = [...new Set(jobs.map((job) => job.department))].sort();
const locations = [...new Set(jobs.map((job) => job.location))].sort();
---

<Layout title="Caldova Careers — Open roles">
  <div class="py-8">
    <section class="mb-10">
      <h1 class="text-4xl font-bold text-slate-100 mb-3">Build the future of medicine</h1>
      <p class="text-lg text-slate-400 max-w-2xl">
        Caldova is an AI-native pharmaceutical company. Explore our open roles
        and help us bring better treatments to patients faster.
      </p>
    </section>

    <h2 class="text-2xl font-medium mb-6 text-slate-100">Open roles</h2>

    {jobs.length === 0 ? (
      <EmptyState text="There are no open roles right now. Check back soon." />
    ) : (
      <>
        <section
          aria-label="Filter open roles"
          class="mb-8 grid grid-cols-1 sm:grid-cols-[1fr_1fr_auto] gap-4 items-end"
          data-testid="role-filters"
        >
          <div>
            <label for="department-filter" class="block text-sm font-medium text-slate-200 mb-2">
              Department
            </label>
            <select
              id="department-filter"
              data-testid="department-filter"
              class="w-full rounded-lg border border-slate-600 bg-slate-800 px-3 py-2 text-slate-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500"
            >
              <option value="">All departments</option>
              {departments.map((department) => <option value={department}>{department}</option>)}
            </select>
          </div>
          <div>
            <label for="location-filter" class="block text-sm font-medium text-slate-200 mb-2">
              Location
            </label>
            <select
              id="location-filter"
              data-testid="location-filter"
              class="w-full rounded-lg border border-slate-600 bg-slate-800 px-3 py-2 text-slate-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500"
            >
              <option value="">All locations</option>
              {locations.map((location) => <option value={location}>{location}</option>)}
            </select>
          </div>
          <button
            type="button"
            data-testid="filters-reset"
            class="rounded-lg border border-slate-600 px-4 py-2 text-slate-200 hover:border-blue-500 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500"
          >
            Reset filters
          </button>
        </section>

        <div
          class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6"
          data-testid="roles-grid"
          data-jobs={JSON.stringify(jobs)}
        >
          {jobs.map((job) => <RoleCard job={job} />)}
        </div>
        <div hidden data-testid="filter-empty-state" aria-live="polite">
          <EmptyState text="No roles match these filters. Try changing or resetting your filters." />
        </div>
      </>
    )}
  </div>
</Layout>

<script>
  import { filterJobs } from '../lib/jobs';
  import type { Job } from '../types/job';

  const grid = document.querySelector<HTMLElement>('[data-testid="roles-grid"]');
  const departmentFilter = document.querySelector<HTMLSelectElement>(
    '[data-testid="department-filter"]',
  );
  const locationFilter = document.querySelector<HTMLSelectElement>(
    '[data-testid="location-filter"]',
  );
  const resetButton = document.querySelector<HTMLButtonElement>(
    '[data-testid="filters-reset"]',
  );
  const emptyState = document.querySelector<HTMLElement>(
    '[data-testid="filter-empty-state"]',
  );

  if (grid && departmentFilter && locationFilter && resetButton && emptyState) {
    const jobs: Job[] = JSON.parse(grid.dataset.jobs ?? '[]');
    const cards = Array.from(grid.querySelectorAll<HTMLElement>('[data-job-id]'));

    /** Update visible role cards and the no-match state from the current selections. */
    const updateRoles = (): void => {
      const matchingSlugs = new Set(
        filterJobs(jobs, departmentFilter.value, locationFilter.value).map((job) => job.slug),
      );
      let visibleCount = 0;

      for (const card of cards) {
        const isVisible = matchingSlugs.has(card.dataset.jobId ?? '');
        card.hidden = !isVisible;
        card.classList.toggle('hidden', !isVisible);
        if (isVisible) visibleCount += 1;
      }

      emptyState.hidden = visibleCount > 0;
    };

    departmentFilter.addEventListener('change', updateRoles);
    locationFilter.addEventListener('change', updateRoles);
    resetButton.addEventListener('click', () => {
      departmentFilter.value = '';
      locationFilter.value = '';
      updateRoles();
    });
  }
</script>
